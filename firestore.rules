rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

        function deckData(deckId) {
      return get(/databases/$(database)/documents/decks/$(deckId)).data;
    }

    function faceOk(data, textKey, imageKey) {
      return data[textKey] is string
        && data[textKey].size() <= 600
        && (
          !(imageKey in data)
          || (data[imageKey] is string && data[imageKey].size() <= 180000)
        )
        && (
          data[textKey].size() > 0
          || (imageKey in data && data[imageKey] is string && data[imageKey].size() > 0)
        );
    }

    match /decks/{deckId} {
      allow read: if resource.data.visibility == 'public'
        || owns(resource.data.ownerId);

      allow create: if owns(request.resource.data.ownerId)
        && request.resource.data.keys().hasOnly([
          'ownerId', 'title', 'visibility', 'orientation', 'cardCount', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.visibility in ['public', 'private']
        && (
          !('orientation' in request.resource.data)
          || request.resource.data.orientation in ['vertical', 'horizontal']
        )
        && request.resource.data.cardCount == 0
        && request.resource.data.createdAt is timestamp;

      allow update: if owns(resource.data.ownerId)
        && request.resource.data.keys().hasOnly([
          'ownerId', 'title', 'visibility', 'orientation', 'cardCount', 'createdAt'
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.visibility in ['public', 'private']
        && (
          !('orientation' in request.resource.data)
          || request.resource.data.orientation in ['vertical', 'horizontal']
        )
        && request.resource.data.cardCount is int
        && request.resource.data.cardCount >= 0;

      allow delete: if owns(resource.data.ownerId);

      match /cards/{cardId} {
        allow read: if resource.data.visibility == 'public'
          || owns(resource.data.ownerId);

        allow create: if owns(request.resource.data.ownerId)
          && deckData(deckId).ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'ownerId', 'visibility', 'front', 'back', 'frontImage', 'backImage', 'order'
          ])
          && request.resource.data.visibility == deckData(deckId).visibility
          && faceOk(request.resource.data, 'front', 'frontImage')
          && faceOk(request.resource.data, 'back', 'backImage')
          && request.resource.data.order is number;

        allow update: if owns(resource.data.ownerId)
          && deckData(deckId).ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'ownerId', 'visibility', 'front', 'back', 'frontImage', 'backImage', 'order'
          ])
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.order is number
          && (
            request.resource.data.visibility == deckData(deckId).visibility
            || request.resource.data.visibility == 'private'
          )
          && faceOk(request.resource.data, 'front', 'frontImage')
          && faceOk(request.resource.data, 'back', 'backImage');

        allow delete: if owns(resource.data.ownerId)
          && deckData(deckId).ownerId == request.auth.uid;
      }
    }

    match /users/{userId}/progress/{cardId} {
      allow read, delete: if owns(userId);

      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'deckId', 'deckTitle', 'rating', 'seenAt', 'front', 'back', 'frontImage', 'backImage'
        ])
        && request.resource.data.deckId is string
        && request.resource.data.deckId.size() <= 200
        && request.resource.data.deckTitle is string
        && request.resource.data.deckTitle.size() <= 100
        && request.resource.data.rating in ['got', 'unsure', 'again']
        && request.resource.data.seenAt is number
        && request.resource.data.front is string
        && request.resource.data.front.size() <= 600
        && request.resource.data.back is string
        && request.resource.data.back.size() <= 600
        && request.resource.data.frontImage is string
        && request.resource.data.frontImage.size() <= 180000
        && request.resource.data.backImage is string
        && request.resource.data.backImage.size() <= 180000;
    }
  }
}
